{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "RetryDecision.json",
    "type": "object",
    "properties": {
        "retry": {
            "type": "boolean"
        },
        "delay_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3600000
        },
        "reason": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
        }
    },
    "required": [
        "retry",
        "delay_ms",
        "reason"
    ],
    "unevaluatedProperties": {
        "not": {}
    }
}