{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ores-otel.dev/contracts/client-backpressure/v1/client-backpressure.schema.json",
  "title": "BrowserBackpressureEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_name",
    "phase",
    "transport",
    "reason",
    "observed_at_unix_ms",
    "queue_age_ms",
    "scheduled_delay_ms"
  ],
  "properties": {
    "schema_version": { "const": 1, "type": "integer" },
    "event_name": { "const": "ores.client.backpressure", "type": "string" },
    "phase": {
      "type": "string",
      "enum": ["queued", "delayed", "resumed", "dropped", "rejected"]
    },
    "transport": {
      "type": "string",
      "enum": ["fetch", "rpc", "websocket", "sse", "other"]
    },
    "reason": {
      "type": "string",
      "enum": [
        "local_pacing",
        "server_retry_after",
        "rate_limit",
        "concurrency",
        "queue_full",
        "queue_timeout",
        "transport_backpressure",
        "service_overload",
        "cancelled"
      ]
    },
    "observed_at_unix_ms": { "$ref": "#/$defs/safeInteger" },
    "queued_at_unix_ms": { "$ref": "#/$defs/safeInteger" },
    "queue_age_ms": { "$ref": "#/$defs/safeInteger" },
    "scheduled_delay_ms": { "$ref": "#/$defs/safeInteger" },
    "queue_depth": { "$ref": "#/$defs/safeInteger" },
    "queue_bytes": { "$ref": "#/$defs/safeInteger" },
    "retry_after_ms": { "$ref": "#/$defs/safeInteger" },
    "recommended_next_request_after_ms": { "$ref": "#/$defs/safeInteger" },
    "policy_version": { "$ref": "#/$defs/safeIdentifier" },
    "quota_fence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "limiting_policy_ids": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/safeIdentifier" }
    },
    "attempt": { "$ref": "#/$defs/safeInteger" },
    "operation": { "$ref": "#/$defs/safeIdentifier" },
    "idempotent": { "type": "boolean" }
  },
  "$defs": {
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "safeIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:/-]+$"
    }
  }
}
